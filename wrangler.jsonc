{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maurerfunds",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maurerfunds-db"
    }
  ]
}
